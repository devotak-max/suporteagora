# Copie para .env antes de subir docker-compose.prod.yml
# Em produção troque TODOS os valores por segredos fortes.

# Postgres
POSTGRES_USER=itsm
POSTGRES_PASSWORD=trocar-por-senha-forte
POSTGRES_DB=itsm

# Backend
JWT_SECRET_KEY=trocar-por-uma-chave-aleatoria-com-pelo-menos-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
GUNICORN_WORKERS=4

# Origens CORS aceitas (JSON array - inclua o domínio público do frontend)
CORS_ORIGINS=["https://suporte.suaempresa.com"]

# Frontend
# URL base usada pelo bundle Vite. Em produção mantenha o caminho relativo
# para que o nginx do próprio container faça o proxy reverso para o backend.
VITE_API_URL=/api/v1
FRONTEND_HTTP_PORT=80
